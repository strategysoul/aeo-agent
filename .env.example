ANTHROPIC_API_KEY=

# SEO data sources reached by API key instead of an MCP connector
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEMRUSH_API_KEY=

# Optional research and AI-visibility sources
FIRECRAWL_API_KEY=
NIMBLE_API_KEY=

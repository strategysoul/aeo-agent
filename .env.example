# Copy to .env (gitignored) or set these in your shell / client settings.
# Names only. Never commit real values.

# Where site folders live. Default: ~/Documents/AEO
AEO_ROOT=

# AI-engine API keys, used by scripts/ask_engines.py (stage 4)
